{
  "name": "humiley-portal-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor mobile (iOS + Android) shell for the Humiley People & Workplace Portal (loads portal.humiley.com).",
  "scripts": {
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync ios",
    "sync:android": "cap sync android",
    "assets": "capacitor-assets generate --ios",
    "assets:android": "capacitor-assets generate --android",
    "open": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/assets": "^3.0.5"
  }
}
