# Database (runtime data — do not commit)
*.db
timekeeping.db
# WAL sidecars. journal_mode=WAL leaves these next to the database; they hold committed pages that
# have not been checkpointed yet, so they are live data — and *.db above does not match them.
*.db-wal
*.db-shm

# Deploy secrets / per-server config
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json

# Local preview/launch config (machine-specific)
.claude/

# Capacitor / iOS + Android native build artifacts (generated on the build machine)
mobile/node_modules/
mobile/ios/
mobile/android/
mobile/package-lock.json
humiley-procurement/

# Generated brand deliverables + local reference copies (regenerable outputs, not app source —
# keep them on disk but out of the public repo).
deliverables/
HUMILEY-PROCUREMENT-SPEC.md
static/brand/1.png
static/brand/2.png
static/brand/3.png
static/brand/4.png
static/brand/5.png

# The live staging site definition — carries a real domain and a password hash, and must survive
# the auto-deploy git pull. The committed template is caddy.d/staging.caddy.example.
caddy.d/staging.caddy
